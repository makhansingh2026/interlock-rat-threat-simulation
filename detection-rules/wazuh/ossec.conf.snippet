<!--
  ============================================================================
  INTERLOCK RAT — Wazuh Active Response (v2)
  Author: Makhan Singh — Seneca Polytechnic, SPR600 Security Monitoring
  File:   /var/ossec/etc/ossec.conf  (append inside <ossec_config>)

  Active-response configuration from the
  lab manual §11.2 — firing firewall-drop on rule 100001 (PowerShell Bypass)
  and rule 100003 (Registry Run key persistence) for 600 seconds.
  Restart manager after edits: sudo systemctl restart wazuh-manager
  ============================================================================
-->
<active-response>
  <command>firewall-drop</command>
  <location>local</location>
  <rules_id>100001,100003</rules_id>
  <timeout>600</timeout>
</active-response>

