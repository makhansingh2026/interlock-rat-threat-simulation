<!--
  ============================================================================
  INTERLOCK RAT Detection — Wazuh custom HIDS rules (v2)
  Author: Makhan Singh — Seneca Polytechnic, SPR600 Security Monitoring
  File:   /var/ossec/etc/rules/local_rules.xml
  Reference: https://thedfirreport.com/2025/07/14/kongtuke-filefix-leads-to-new-interlock-rat-variant/
  ============================================================================
-->
<group name="interlock,">

  <!-- ========================================================================
       RULES 
       ====================================================================== -->

  <!-- 100001 — PowerShell with Bypass execution policy (T1059.001) -->
  <rule id="100001" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine">-ep Bypass|ExecutionPolicy Bypass</field>
    <description>INTERLOCK: PowerShell with Bypass execution policy</description>
    <mitre><id>T1059.001</id></mitre>
    <group>execution,defense_evasion,</group>
  </rule>

  <!-- 100002 — File creation in AppData\Roaming\php (T1105) -->
  <rule id="100002" level="12">
    <if_group>sysmon_event11</if_group>
    <field name="win.eventdata.targetFilename">AppData.+Roaming.+php</field>
    <description>INTERLOCK: File created in AppData\Roaming\php (RAT staging)</description>
    <mitre><id>T1105</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- 100003 — Registry Run key persistence (T1547.001) -->
  <rule id="100003" level="14">
    <if_group>sysmon_event13</if_group>
    <field name="win.eventdata.targetObject">CurrentVersion.+Run</field>
    <description>INTERLOCK: Registry Run key modified (persistence)</description>
    <mitre><id>T1547.001</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- 100004 — Discovery with JSON output pattern (T1082) -->
  <rule id="100004" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine">ConvertTo-Json</field>
    <description>INTERLOCK: Discovery command with JSON exfil pattern</description>
    <mitre><id>T1082</id></mitre>
    <group>discovery,exfiltration,</group>
  </rule>

  <!-- 100005 — AD enumeration (T1018) -->
  <rule id="100005" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine">adsiSearcher|nltest /dclist|net user.+/domain</field>
    <description>INTERLOCK: Active Directory enumeration detected</description>
    <mitre><id>T1018</id></mitre>
    <group>discovery,</group>
  </rule>

  <!-- 100006 — Scheduled task deletion - dropper cleanup (T1053.005) -->
  <rule id="100006" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine">schtasks /delete /tn Updater</field>
    <description>INTERLOCK: Scheduled task Updater deleted (dropper behavior)</description>
    <mitre><id>T1053.005</id></mitre>
    <group>defense_evasion,</group>
  </rule>

   <!-- 100008 — Encoded PowerShell command (-enc / -EncodedCommand) -->
  <rule id="100008" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">powershell\.exe|pwsh\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">-(e|en|enc|enco|encod|encode|encodedcommand)\s+[A-Za-z0-9+/=]{30,}</field>
    <description>INTERLOCK: PowerShell EncodedCommand with base64 payload (T1027 obfuscation)</description>
    <mitre><id>T1059.001</id><id>T1027</id></mitre>
    <group>execution,defense_evasion,</group>
  </rule>

  <!-- 100009 — explorer.exe spawning powershell.exe (FileFix Run-dialog pattern) -->
  <rule id="100009" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage">explorer\.exe</field>
    <field name="win.eventdata.image">powershell\.exe|pwsh\.exe|cmd\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(IEX|Invoke-Expression|DownloadString|New-Object)</field>
    <description>INTERLOCK: explorer.exe spawned PowerShell with downloader (likely FileFix paste-and-run)</description>
    <mitre><id>T1566.001</id><id>T1059.001</id><id>T1204.002</id></mitre>
    <group>initial_access,execution,</group>
  </rule>

