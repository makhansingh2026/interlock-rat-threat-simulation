<!--
  ============================================================================
  INTERLOCK RAT Detection — Wazuh custom HIDS rules (v2)
  Author: Makhan Singh — Seneca Polytechnic, SPR600 Security Monitoring
  File:   /var/ossec/etc/rules/local_rules.xml

  What changed in v2
  ------------------
  Original rule IDs 100001-100006 are PRESERVED with their original level,
  description text, and field matchers, so the existing lab manual, project
  report, and Wazuh dashboards still reference accurate rule numbers and
  alert text. The only change to those six rules is the addition of a
  <group> tag for SOC dashboarding.

  v2 also adds 18 new rules (100007-100025) that detect the real-world
  KongTuke -> Interlock RAT campaign documented by The DFIR Report (July 2025)
  rather than only the lab artefacts. The single highest-value addition is
  rule 100017 (DNS query to *.trycloudflare.com) — the actual C2 channel
  used by the in-the-wild Interlock variant.

  Telemetry
  ---------
  Sysmon (SwiftOnSecurity config) on Goku-mak / Krillin-mak / DC, forwarded
  via Wazuh agent to the manager. Restart manager after edits:
    sudo systemctl restart wazuh-manager

  Reference: https://thedfirreport.com/2025/07/14/kongtuke-filefix-leads-to-new-interlock-rat-variant/
  ============================================================================
-->
<group name="interlock,">

  <!-- ========================================================================
       ORIGINAL RULES (IDs, levels, descriptions, and field matchers PRESERVED)
       ====================================================================== -->

  <!-- 100001 — PowerShell with Bypass execution policy (T1059.001) -->
  <rule id="100001" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine">-ep Bypass|ExecutionPolicy Bypass</field>
    <description>INTERLOCK: PowerShell with Bypass execution policy</description>
    <mitre><id>T1059.001</id></mitre>
    <group>execution,defense_evasion,</group>
  </rule>

  <!-- 100002 — File creation in AppData\Roaming\php (T1105) -->
  <rule id="100002" level="12">
    <if_group>sysmon_event11</if_group>
    <field name="win.eventdata.targetFilename">AppData.+Roaming.+php</field>
    <description>INTERLOCK: File created in AppData\Roaming\php (RAT staging)</description>
    <mitre><id>T1105</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- 100003 — Registry Run key persistence (T1547.001) -->
  <rule id="100003" level="14">
    <if_group>sysmon_event13</if_group>
    <field name="win.eventdata.targetObject">CurrentVersion.+Run</field>
    <description>INTERLOCK: Registry Run key modified (persistence)</description>
    <mitre><id>T1547.001</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- 100004 — Discovery with JSON output pattern (T1082) -->
  <rule id="100004" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine">ConvertTo-Json</field>
    <description>INTERLOCK: Discovery command with JSON exfil pattern</description>
    <mitre><id>T1082</id></mitre>
    <group>discovery,exfiltration,</group>
  </rule>

  <!-- 100005 — AD enumeration (T1018) -->
  <rule id="100005" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine">adsiSearcher|nltest /dclist|net user.+/domain</field>
    <description>INTERLOCK: Active Directory enumeration detected</description>
    <mitre><id>T1018</id></mitre>
    <group>discovery,</group>
  </rule>

  <!-- 100006 — Scheduled task deletion - dropper cleanup (T1053.005) -->
  <rule id="100006" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine">schtasks /delete /tn Updater</field>
    <description>INTERLOCK: Scheduled task Updater deleted (dropper behavior)</description>
    <mitre><id>T1053.005</id></mitre>
    <group>defense_evasion,</group>
  </rule>


  <!-- ========================================================================
       NEW IN V2 — EXECUTION (T1059.001 PowerShell)
       ====================================================================== -->

  <!-- 100007 — PowerShell hidden window + bypass chained (high confidence) -->
  <rule id="100007" level="13">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">-w(indowstyle)?\s+hidden</field>
    <description>INTERLOCK: PowerShell with Hidden Window AND ExecutionPolicy Bypass (dropper pattern)</description>
    <mitre><id>T1059.001</id><id>T1564.003</id></mitre>
    <group>execution,defense_evasion,</group>
  </rule>

  <!-- 100008 — Encoded PowerShell command (-enc / -EncodedCommand) -->
  <rule id="100008" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">powershell\.exe|pwsh\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">-(e|en|enc|enco|encod|encode|encodedcommand)\s+[A-Za-z0-9+/=]{30,}</field>
    <description>INTERLOCK: PowerShell EncodedCommand with base64 payload (T1027 obfuscation)</description>
    <mitre><id>T1059.001</id><id>T1027</id></mitre>
    <group>execution,defense_evasion,</group>
  </rule>

  <!-- 100009 — explorer.exe spawning powershell.exe (FileFix Run-dialog pattern) -->
  <rule id="100009" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage">explorer\.exe</field>
    <field name="win.eventdata.image">powershell\.exe|pwsh\.exe|cmd\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(IEX|Invoke-Expression|DownloadString|New-Object)</field>
    <description>INTERLOCK: explorer.exe spawned PowerShell with downloader (likely FileFix paste-and-run)</description>
    <mitre><id>T1566.001</id><id>T1059.001</id><id>T1204.002</id></mitre>
    <group>initial_access,execution,</group>
  </rule>

  <!-- 100010 — Inline IEX downloader pattern in PowerShell command line -->
  <rule id="100010" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">powershell\.exe|pwsh\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(IEX|Invoke-Expression).{0,200}(New-Object).{0,80}Net\.WebClient</field>
    <description>INTERLOCK: PowerShell IEX downloader (IEX + New-Object Net.WebClient)</description>
    <mitre><id>T1059.001</id><id>T1105</id></mitre>
    <group>execution,command_and_control,</group>
  </rule>

  <!-- 100011 — PowerShell DownloadString/DownloadFile to bare IP -->
  <rule id="100011" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">powershell\.exe|pwsh\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">DownloadString|DownloadFile|Invoke-WebRequest|iwr|curl|wget</field>
    <field name="win.eventdata.commandLine" type="pcre2">https?://(\d{1,3}\.){3}\d{1,3}</field>
    <description>INTERLOCK: PowerShell downloader fetching from bare IP host (no DNS)</description>
    <mitre><id>T1059.001</id><id>T1105</id></mitre>
    <group>execution,command_and_control,</group>
  </rule>


  <!-- ========================================================================
       NEW IN V2 — INGRESS TOOL TRANSFER & PERSISTENCE
       ====================================================================== -->

  <!-- 100012 — Generic dropper file write to user-writable directories -->
  <rule id="100012" level="10">
    <if_group>sysmon_event11</if_group>
    <field name="win.eventdata.targetFilename" type="pcre2">\\(AppData\\(Local|Roaming)|Public|Users\\Public|Windows\\Temp|Temp)\\.+\.(ps1|exe|dll|hta|vbs|js|bat|cmd)$</field>
    <description>INTERLOCK: Dropper file written to user-writable directory</description>
    <mitre><id>T1105</id></mitre>
    <group>persistence,defense_evasion,</group>
  </rule>

  <!-- 100013 — Image File Execution Options debugger hijack -->
  <rule id="100013" level="14">
    <if_group>sysmon_event13</if_group>
    <field name="win.eventdata.targetObject">Image File Execution Options</field>
    <field name="win.eventdata.details">Debugger</field>
    <description>INTERLOCK: IFEO Debugger registry value set (binary hijack persistence)</description>
    <mitre><id>T1546.012</id></mitre>
    <group>persistence,privilege_escalation,</group>
  </rule>

  <!-- 100014 — Scheduled task creation -->
  <rule id="100014" level="11">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">schtasks\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">schtasks\s+/(create|change)</field>
    <description>INTERLOCK: Scheduled task created or modified via schtasks.exe</description>
    <mitre><id>T1053.005</id></mitre>
    <group>persistence,</group>
  </rule>


  <!-- ========================================================================
       NEW IN V2 — DISCOVERY (T1018, T1082, T1087, T1033)
       ====================================================================== -->

  <!-- 100015 — Local recon command burst (whoami, hostname, net user, ipconfig) -->
  <rule id="100015" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(whoami|hostname|systeminfo|ipconfig|net|tasklist|netstat)\.exe$</field>
    <description>INTERLOCK: Local recon utility executed (whoami / systeminfo / net / etc.)</description>
    <mitre><id>T1033</id><id>T1082</id><id>T1016</id></mitre>
    <group>discovery,</group>
  </rule>


  <!-- ========================================================================
       NEW IN V2 — COMMAND AND CONTROL (Sysmon Event 22 = DNS, Event 3 = Network)
       ====================================================================== -->

  <!-- 100017 — DNS query for Cloudflare Tunnel (highest-value real-world IOC) -->
  <rule id="100017" level="13">
    <if_group>sysmon_event22</if_group>
    <field name="win.eventdata.queryName" type="pcre2">\.trycloudflare\.com$</field>
    <description>INTERLOCK: DNS query for Cloudflare Tunnel (.trycloudflare.com) — known RAT C2 infrastructure</description>
    <mitre><id>T1090.004</id><id>T1071.001</id></mitre>
    <group>command_and_control,</group>
  </rule>

  <!-- 100018 — DNS query for Cloudflare Workers (lower confidence, broader use) -->
  <rule id="100018" level="9">
    <if_group>sysmon_event22</if_group>
    <field name="win.eventdata.queryName" type="pcre2">\.workers\.dev$</field>
    <description>INTERLOCK: DNS query for Cloudflare Workers domain (potential C2 abuse)</description>
    <mitre><id>T1090.004</id></mitre>
    <group>command_and_control,</group>
  </rule>

  <!-- 100019 — PowerShell making outbound network connection -->
  <rule id="100019" level="10">
    <if_group>sysmon_event3</if_group>
    <field name="win.eventdata.image">powershell\.exe|pwsh\.exe</field>
    <field name="win.eventdata.initiated">true</field>
    <description>INTERLOCK: PowerShell process initiated outbound network connection</description>
    <mitre><id>T1059.001</id><id>T1071.001</id></mitre>
    <group>command_and_control,execution,</group>
  </rule>


  <!-- ========================================================================
       NEW IN V2 — DEFENSE EVASION & IMPAIR DEFENSES (T1562)
       ====================================================================== -->

  <!-- 100020 — Defender / WinDefend service stopped or disabled -->
  <rule id="100020" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(sc\s+(stop|config)|Set-MpPreference\s+-Disable|Stop-Service).{0,80}(WinDefend|MsMpSvc|Sense)</field>
    <description>INTERLOCK: Windows Defender service stop/disable attempt</description>
    <mitre><id>T1562.001</id></mitre>
    <group>defense_evasion,</group>
  </rule>

  <!-- 100021 — AMSI / ETW bypass strings in PowerShell command line -->
  <rule id="100021" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(amsiInitFailed|AmsiUtils|amsi\.dll|EtwEventWrite)</field>
    <description>INTERLOCK: AMSI or ETW bypass technique observed in PowerShell command line</description>
    <mitre><id>T1562.001</id><id>T1562.006</id></mitre>
    <group>defense_evasion,</group>
  </rule>


  <!-- ========================================================================
       NEW IN V2 — LATERAL MOVEMENT (T1021, T1570)
       ====================================================================== -->

  <!-- 100022 — Successful remote interactive logon (RDP) — Win Event 4624 type 10 -->
  <rule id="100022" level="9">
    <if_group>windows_security</if_group>
    <field name="win.eventdata.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^10$</field>
    <description>INTERLOCK: Successful remote interactive logon (RDP) — review against baseline</description>
    <mitre><id>T1021.001</id></mitre>
    <group>lateral_movement,authentication,</group>
  </rule>

  <!-- 100023 — Service install consistent with PsExec / Impacket -->
  <rule id="100023" level="14">
    <if_group>windows_security</if_group>
    <field name="win.eventdata.eventID">^7045$</field>
    <field name="win.eventdata.serviceName" type="pcre2">PSEXESVC|^[A-Za-z]{8,16}$</field>
    <field name="win.eventdata.imagePath" type="pcre2">\\\\.+\\ADMIN\$|\\Windows\\PSEXESVC</field>
    <description>INTERLOCK: PsExec/Impacket service install on remote host</description>
    <mitre><id>T1021.002</id><id>T1569.002</id></mitre>
    <group>lateral_movement,</group>
  </rule>


  <!-- ========================================================================
       NEW IN V2 — CORRELATION (high-confidence multi-event detection)
       ====================================================================== -->

  <!-- 100025 — Encoded PowerShell + outbound network connection on same host within 60s -->
  <rule id="100025" level="15" frequency="2" timeframe="60">
    <if_matched_sid>100008</if_matched_sid>
    <if_sid>100019</if_sid>
    <same_source_ip />
    <description>INTERLOCK CORRELATION: Encoded PowerShell + outbound network connection on same host within 60s</description>
    <mitre><id>T1059.001</id><id>T1071.001</id><id>T1027</id></mitre>
    <group>execution,command_and_control,</group>
  </rule>

</group>
