# ==============================================================================
# INTERLOCK RAT DETECTION RULES — Suricata custom ruleset (v2)
# Author: Makhan Singh — Seneca Polytechnic, SPR600 Security Monitoring
# File:   /etc/suricata/rules/custom.rules
# ==============================================================================
#
# Suricata environment
# --------------------
#   HOME_NET     = [10.0.10.0/24]    (victim subnet)
#   EXTERNAL_NET = !$HOME_NET
#   HTTP_PORTS   = 80, 8080, 8081, 3000, 8000, 8008, 8888
#   action-order = pass -> drop -> reject -> alert
#   logging      = eve.json
#   IPS mode     = NFQUEUE queue 0 on the Router
#
# References
# ----------
#   The DFIR Report — KongTuke FileFix Leads to New Interlock RAT Variant
#     https://thedfirreport.com/2025/07/14/kongtuke-filefix-leads-to-new-interlock-rat-variant/
#   MITRE ATT&CK — https://attack.mitre.org/
#
# Coverage
# --------
# alerts  : 1000001-1000006, 1000008, 1000009, 1000013
# drops   : 1000010, 1000011, 1000012

# ==============================================================================


# ==============================================================================
# ALERT RULES 
# ==============================================================================

# 1000001 — PowerShell User-Agent in HTTP (initial dropper download)
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK - PowerShell User-Agent Detected"; \
  flow:established,to_server; \
  http.user_agent; content:"PowerShell"; nocase; \
  classtype:trojan-activity; \
  reference:url,attack.mitre.org/techniques/T1059/001/; \
  reference:url,thedfirreport.com/2025/07/14/kongtuke-filefix-leads-to-new-interlock-rat-variant/; \
  metadata:mitre_attack_id T1059.001, mitre_attack_tactic Execution, signature_severity Major, deployment Perimeter, confidence High; \
  sid:1000001; rev:2;)

# 1000002 — PowerShell script download (.ps1 in URI)
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK - PowerShell Script Download (.ps1)"; \
  flow:established,to_server; \
  http.method; content:"GET"; \
  http.uri; pcre:"/\.ps1(\?|$)/i"; \
  classtype:trojan-activity; \
  reference:url,attack.mitre.org/techniques/T1105/; \
  metadata:mitre_attack_id T1105, mitre_attack_tactic Command-and-Control, signature_severity Major, deployment Perimeter, confidence Medium; \
  sid:1000002; rev:2;)

# 1000003 — C2 command polling (GET /cmd)
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK - C2 Command Poll (/cmd)"; \
  flow:established,to_server; \
  http.method; content:"GET"; \
  http.uri; content:"/cmd"; startswith; \
  classtype:trojan-activity; \
  metadata:mitre_attack_id T1071.001, mitre_attack_tactic Command-and-Control, signature_severity Major, deployment Perimeter, confidence High; \
  sid:1000003; rev:2;)

# 1000004 — Data exfiltration (POST /exfil)
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK - Data Exfiltration (/exfil)"; \
  flow:established,to_server; \
  http.method; content:"POST"; \
  http.uri; content:"/exfil"; startswith; \
  classtype:trojan-activity; \
  metadata:mitre_attack_id T1041, mitre_attack_tactic Exfiltration, signature_severity Major, deployment Perimeter, confidence High; \
  sid:1000004; rev:2;)

# 1000005 — RAT beacon check-in (POST /beacon)
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK - RAT Beacon Check-in"; \
  flow:established,to_server; \
  http.method; content:"POST"; \
  http.uri; content:"/beacon"; startswith; \
  classtype:trojan-activity; \
  metadata:mitre_attack_id T1071.001, mitre_attack_tactic Command-and-Control, signature_severity Major, deployment Perimeter, confidence High; \
  sid:1000005; rev:2;)

# 1000006 — Command result upload (POST /result)
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK - C2 Command Result Upload"; \
  flow:established,to_server; \
  http.method; content:"POST"; \
  http.uri; content:"/result"; startswith; \
  classtype:trojan-activity; \
  metadata:mitre_attack_id T1071.001, mitre_attack_tactic Command-and-Control, signature_severity Major, deployment Perimeter, confidence High; \
  sid:1000006; rev:2;)

# 1000008 — JSON POST from victim to external (general exfil pattern)
# v2 refinement: threshold + dsize<1024 to suppress noise and bias toward
# beacon-style traffic. Still fires on the lab's exfil but no longer floods.
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK - JSON POST to External"; \
  flow:established,to_server; \
  http.method; content:"POST"; \
  http.content_type; content:"application/json"; nocase; \
  http.request_body; dsize:<1024; \
  threshold: type limit, track by_src, count 1, seconds 300; \
  classtype:trojan-activity; \
  metadata:mitre_attack_id T1071.001, mitre_attack_tactic Command-and-Control, signature_severity Minor, deployment Perimeter, confidence Low; \
  sid:1000008; rev:2;)

# 1000009 — RDP from DC to workstation (direct cross-subnet lateral movement)
# v2 refinement: kept the single-DC source (10.0.10.200 = Goku-mak) but added
# flow:established,to_server tracking + MITRE metadata. Note: in this lab the
# port-forward pivot keeps Goku-mak->Krillin-mak traffic intra-subnet, so this
# rule will not fire (Lessons Learned #4 in the report). It remains in place
# for defensive coverage if future scenarios add cross-subnet RDP.
alert tcp 10.0.10.200 any -> $HOME_NET 3389 ( \
  msg:"INTERLOCK - RDP Lateral Movement from DC"; \
  flow:established,to_server; \
  classtype:trojan-activity; \
  reference:url,attack.mitre.org/techniques/T1021/001/; \
  metadata:mitre_attack_id T1021.001, mitre_attack_tactic Lateral-Movement, signature_severity Major, deployment Internal, confidence High; \
  sid:1000009; rev:2;)

# 1000013 — RDP pivot via port forward
# v2 refinement: original rule hardcoded port 33890. New version detects RDP
# negotiated on ANY non-3389 port via the X.224 / mstshash cookie pattern, so
# the rule generalises beyond the lab's specific port choice without changing
# what conceptually triggers it (an RDP pivot through a forwarded port).
alert tcp $EXTERNAL_NET any -> $HOME_NET ![3389] ( \
  msg:"INTERLOCK - RDP Pivot via Port Forward"; \
  flow:established,to_server; \
  content:"|03 00|"; offset:0; depth:2; \
  content:"Cookie: mstshash="; nocase; distance:0; within:64; \
  classtype:trojan-activity; \
  reference:url,attack.mitre.org/techniques/T1572/; \
  metadata:mitre_attack_id T1572, mitre_attack_tactic Command-and-Control, signature_severity Major, deployment Internal, confidence High; \
  sid:1000013; rev:3;)


# ==============================================================================
# IPS DROP RULES 
# ==============================================================================

# 1000010 — DROP: lab Flask C2 command channel
drop http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK IPS - BLOCK C2 Beacon"; \
  flow:established,to_server; \
  http.method; content:"GET"; \
  http.uri; content:"/cmd"; startswith; \
  classtype:trojan-activity; \
  metadata:mitre_attack_id T1071.001, signature_severity Major, deployment Perimeter, confidence High; \
  sid:1000010; rev:2;)

# 1000011 — DROP: lab Flask C2 exfiltration channel
drop http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK IPS - BLOCK Exfiltration"; \
  flow:established,to_server; \
  http.method; content:"POST"; \
  http.uri; content:"/exfil"; startswith; \
  classtype:trojan-activity; \
  metadata:mitre_attack_id T1041, signature_severity Major, deployment Perimeter, confidence High; \
  sid:1000011; rev:2;)

# 1000012 — DROP: PowerShell User-Agent egress
drop http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"INTERLOCK IPS - BLOCK PowerShell Download"; \
  flow:established,to_server; \
  http.user_agent; content:"PowerShell"; nocase; \
  classtype:trojan-activity; \
  metadata:mitre_attack_id T1059.001, signature_severity Major, deployment Perimeter, confidence High; \
  sid:1000012; rev:2;)

